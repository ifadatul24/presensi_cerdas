# ==============================================================================
# KONFIGURASI LINGKUNGAN SISTEM PRESENSI CERDAS (STANDALONE NON-DOCKER READY)
# ==============================================================================

PORT=4000
NODE_ENV=development

# ------------------------------------------------------------------------------
# Database: Pilihan 'sqlite' (Default Standalone / Tanpa Docker) atau 'postgres'
# ------------------------------------------------------------------------------
DB_TYPE=sqlite
SQLITE_PATH=./database/presensi.sqlite

# Jika suatu saat menggunakan PostgreSQL (On-Premise atau Cloud Supabase/Neon):
# DB_TYPE=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=presensi_user
# DB_PASSWORD=presensi_secret_pass
# DB_NAME=presensi_cerdas_db

# ------------------------------------------------------------------------------
# Redis (Opsional - Otomatis fallback ke In-Memory cache jika tanpa Docker)
# ------------------------------------------------------------------------------
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# RabbitMQ (Opsional - Otomatis fallback ke direct HTTP REST API jika tanpa Docker)
# ------------------------------------------------------------------------------
RABBITMQ_ENABLED=false
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_QUEUE_ATTENDANCE=attendance_events

# ------------------------------------------------------------------------------
# Keamanan & JWT
# ------------------------------------------------------------------------------
JWT_SECRET=super_secret_jwt_presensi_cerdas_key_2026
JWT_EXPIRATION=7d

# ------------------------------------------------------------------------------
# AI Engine
# ------------------------------------------------------------------------------
AI_ENGINE_HOST=localhost
AI_ENGINE_PORT=8001
AI_CONFIDENCE_THRESHOLD=0.85
AI_DEBOUNCE_COOLDOWN_SECONDS=600

# ------------------------------------------------------------------------------
# Storage
# ------------------------------------------------------------------------------
UPLOAD_DIR=./uploads/snapshots
